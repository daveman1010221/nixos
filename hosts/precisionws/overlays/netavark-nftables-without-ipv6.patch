From c9fa7c0f595319a2ea8a7439185e196f2610ff46 Mon Sep 17 00:00:00 2001
From: David Shepard <daveman1010220@gmail.com>
Date: Wed, 28 Oct 2026 09:59:59 -0400
Subject: [PATCH] fix(nftables): use an ip table on kernels without IPv6

The nftables driver puts all of netavark's chains and rules in one table
of the inet family. The inet family needs a kernel with IPv6
(NF_TABLES_INET depends on IPV6), so on a kernel built without IPv6 no
table can be made, and every network fails to set up, with or without
port mappings: "Could not process rule: No such file or directory".

On such a kernel every network and address is IPv4, and so is every rule
netavark makes, so the table can be of the ip family instead. The family
is chosen once, by whether /proc/sys/net/ipv6 exists, and used for the
table, its chains and rules, and when listing it. An IPv6 subnet on such
a kernel is refused with a clear error.

Tested rootless with podman 5.8.9 on Linux 7.3 built without IPv6:
published ports reached from the host's loopback and LAN addresses,
outbound masquerading, aardvark-dns name resolution on a named network,
isolation between two isolate=true networks, and teardown leaving no
rules behind.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QAe3biqjeQJRMfngB95eyW
---
 src/firewall/nft.rs | 56 +++++++++++++++++++++++++++++++++++++++------
 1 file changed, 49 insertions(+), 7 deletions(-)

diff --git a/src/firewall/nft.rs b/src/firewall/nft.rs
index 3eba30a3..fb6cb5b6 100644
--- a/src/firewall/nft.rs
+++ b/src/firewall/nft.rs
@@ -15,6 +15,8 @@ use std::borrow::Cow;
 use std::collections::HashSet;
 use std::net::{IpAddr, Ipv4Addr};
 use std::ops::Deref;
+use std::path::Path;
+use std::sync::OnceLock;
 
 const TABLENAME: &str = "netavark";
 
@@ -41,6 +43,40 @@ const FILTERPRIO: i32 = 0;
 
 const IPV4_LOCALHOST: IpAddr = IpAddr::V4(Ipv4Addr::LOCALHOST);
 
+/// The family of netavark's table, and of every chain and rule in it.
+///
+/// It is `inet`, which serves IPv4 and IPv6 alike, wherever it can be: the `inet` family needs a kernel with IPv6
+/// (NF_TABLES_INET depends on IPV6). On a kernel without IPv6, where no `inet` table can be made, it is `ip`: there
+/// every network and address is IPv4, and so is every rule.
+fn table_family() -> types::NfFamily {
+    static FAMILY: OnceLock<types::NfFamily> = OnceLock::new();
+    *FAMILY.get_or_init(|| {
+        if Path::new("/proc/sys/net/ipv6").exists() {
+            types::NfFamily::INet
+        } else {
+            types::NfFamily::IP
+        }
+    })
+}
+
+/// The table's family as nft names it on its command line.
+fn table_family_name() -> &'static str {
+    match table_family() {
+        types::NfFamily::IP => "ip",
+        _ => "inet",
+    }
+}
+
+/// An IPv6 subnet cannot be served from an `ip` table, nor by a kernel without IPv6.
+fn check_subnet_family(subnet: &IpNet) -> NetavarkResult<()> {
+    if subnet.addr().is_ipv6() && table_family() == types::NfFamily::IP {
+        return Err(NetavarkError::Message(format!(
+            "network subnet {subnet} is IPv6, but this kernel has no IPv6 support"
+        )));
+    }
+    Ok(())
+}
+
 pub struct Nftables {}
 
 pub fn new() -> Result<Box<dyn firewall::FirewallDriver>, NetavarkError> {
@@ -57,11 +93,17 @@ impl firewall::FirewallDriver for Nftables {
         network_setup: internal_types::SetupNetwork,
         dbus_conn: &Option<zbus::blocking::Connection>,
     ) -> NetavarkResult<()> {
+        if let Some(subnets) = &network_setup.subnets {
+            for subnet in subnets {
+                check_subnet_family(subnet)?;
+            }
+        }
+
         let mut batch = Batch::new();
 
         // Overall table
         batch.add(schema::NfListObject::Table(schema::Table {
-            family: types::NfFamily::INet,
+            family: table_family(),
             name: Cow::Borrowed(TABLENAME),
             ..schema::Table::default()
         }));
@@ -1093,7 +1135,7 @@ fn get_dnat_rules_for_addr_family<'a>(
 /// Make a DNAT rule to allow DNS traffic to a DNS server on a non-standard port (53 -> actual port).
 fn make_dns_dnat_rule(dns_ip: &IpAddr, dns_port: u16) -> schema::NfListObject<'_> {
     let rule = schema::Rule {
-        family: types::NfFamily::INet,
+        family: table_family(),
         table: Cow::Borrowed(TABLENAME),
         chain: Cow::Borrowed(DNATCHAIN),
         expr: Cow::Owned(vec![
@@ -1141,10 +1183,10 @@ fn get_jump_action(target: Cow<str>) -> stmt::Statement {
 }
 
 /// Create an instruction to make a basic chain (no hooks, no priority).
-/// Chain is always inet, always in our overall netavark table.
+/// Chain is always in our overall netavark table, of its family (table_family).
 fn make_basic_chain(name: Cow<str>) -> schema::NfListObject {
     schema::NfListObject::Chain(schema::Chain {
-        family: types::NfFamily::INet,
+        family: table_family(),
         table: Cow::Borrowed(TABLENAME),
         name,
         ..schema::Chain::default()
@@ -1160,7 +1202,7 @@ fn make_complex_chain(
     priority: i32,
 ) -> schema::NfListObject<'_> {
     schema::NfListObject::Chain(schema::Chain {
-        family: types::NfFamily::INet,
+        family: table_family(),
         table: Cow::Borrowed(TABLENAME),
         name: Cow::Borrowed(name),
         _type: Some(chain_type),
@@ -1177,7 +1219,7 @@ fn make_rule<'a>(
     conditions: Cow<'a, [stmt::Statement<'a>]>,
 ) -> schema::NfListObject<'a> {
     schema::NfListObject::Rule(schema::Rule {
-        family: types::NfFamily::INet,
+        family: table_family(),
         table: Cow::Borrowed(TABLENAME),
         chain,
         expr: conditions,
@@ -1278,7 +1320,7 @@ fn get_chain<'a>(base_rules: &schema::Nftables<'a>, chain: &str) -> Option<schem
 }
 
 fn get_netavark_rules() -> Result<schema::Nftables<'static>, helper::NftablesError> {
-    match helper::get_current_ruleset_with_args(None::<&str>, ["list", "table", "inet", TABLENAME])
+    match helper::get_current_ruleset_with_args(None::<&str>, ["list", "table", table_family_name(), TABLENAME])
     {
         Ok(rules) => Ok(rules),
         Err(err) => match err {
