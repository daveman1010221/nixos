+#[cfg(test)]
+mod test {
+    use super::*;
+    use nftnl::nftnl_sys as sys;
+    use std::{ffi::CStr, mem::size_of};
+    use talpid_dns::DnsConfig;
+    use talpid_types::net::{AllowedClients, AllowedTunnelTraffic, Endpoint};
+
+    /// The parts of an nftables expression these tests look at.
+    #[derive(Debug)]
+    enum Expr {
+        /// `meta` with this key.
+        Meta(u32),
+        /// `cmp` against this data.
+        Cmp(Vec<u8>),
+        /// `payload` load of `len` bytes from header `base`.
+        Payload {
+            base: u32,
+            len: u32,
+        },
+        Other,
+    }
+
+    /// Every rule `batch` adds, parsed back into its expressions.
+    fn rules(batch: &FinalizedBatch) -> Vec<Vec<Expr>> {
+        let new_rule = ((libc::NFNL_SUBSYS_NFTABLES as u16) << 8) | libc::NFT_MSG_NEWRULE as u16;
+        let mut rules = vec![];
+        for mut page in batch {
+            while page.len() >= size_of::<libc::nlmsghdr>() {
+                // SAFETY: The page holds netlink messages built by libnftnl.
+                let header = unsafe { page.as_ptr().cast::<libc::nlmsghdr>().read_unaligned() };
+                if header.nlmsg_type == new_rule {
+                    rules.push(parse_rule(page.as_ptr()));
+                }
+                let len = (header.nlmsg_len as usize).next_multiple_of(4);
+                if len == 0 {
+                    break;
+                }
+                page = &page[len.min(page.len())..];
+            }
+        }
+        rules
+    }
+
+    fn parse_rule(message: *const u8) -> Vec<Expr> {
+        let mut exprs = vec![];
+        // SAFETY: `message` is a complete NFT_MSG_NEWRULE message, and every expression is read
+        // through libnftnl's accessors before the rule is freed.
+        unsafe {
+            let rule = sys::nftnl_rule_alloc();
+            assert_eq!(sys::nftnl_rule_nlmsg_parse(message.cast(), rule), 0);
+            let iter = sys::nftnl_expr_iter_create(rule);
+            loop {
+                let expr = sys::nftnl_expr_iter_next(iter);
+                if expr.is_null() {
+                    break;
+                }
+                let name =
+                    CStr::from_ptr(sys::nftnl_expr_get_str(expr, sys::NFTNL_EXPR_NAME as u16));
+                exprs.push(match name.to_str().unwrap() {
+                    "meta" => Expr::Meta(sys::nftnl_expr_get_u32(
+                        expr,
+                        sys::NFTNL_EXPR_META_KEY as u16,
+                    )),
+                    "cmp" => {
+                        let mut len = 0;
+                        let data = sys::nftnl_expr_get(
+                            expr,
+                            sys::NFTNL_EXPR_CMP_DATA as u16,
+                            &raw mut len,
+                        );
+                        Expr::Cmp(
+                            std::slice::from_raw_parts(data.cast::<u8>(), len as usize).to_vec(),
+                        )
+                    }
+                    "payload" => Expr::Payload {
+                        base: sys::nftnl_expr_get_u32(expr, sys::NFTNL_EXPR_PAYLOAD_BASE as u16),
+                        len: sys::nftnl_expr_get_u32(expr, sys::NFTNL_EXPR_PAYLOAD_LEN as u16),
+                    },
+                    _ => Expr::Other,
+                });
+            }
+            sys::nftnl_expr_iter_destroy(iter);
+            sys::nftnl_rule_free(rule);
+        }
+        exprs
+    }
+
+    /// Counts the IPv6-specific matches in `rules`: checks that a packet is IPv6, ICMPv6 matches,
+    /// and loads of IPv6 addresses.
+    fn count_ipv6_matches(rules: &[Vec<Expr>]) -> usize {
+        let mut ipv6_matches = 0;
+        for rule in rules {
+            let mut meta_key = None;
+            for expr in rule {
+                match expr {
+                    Expr::Meta(key) => meta_key = Some(*key),
+                    Expr::Cmp(data) => match meta_key.take() {
+                        Some(key)
+                            if key == libc::NFT_META_NFPROTO as u32
+                                && data[..] == [libc::NFPROTO_IPV6 as u8] =>
+                        {
+                            ipv6_matches += 1;
+                        }
+                        Some(key)
+                            if key == libc::NFT_META_L4PROTO as u32
+                                && data[..] == [libc::IPPROTO_ICMPV6 as u8] =>
+                        {
+                            ipv6_matches += 1;
+                        }
+                        _ => (),
+                    },
+                    Expr::Payload { base, len } => {
+                        meta_key = None;
+                        if *base == libc::NFT_PAYLOAD_NETWORK_HEADER as u32 && *len == 16 {
+                            ipv6_matches += 1;
+                        }
+                    }
+                    Expr::Other => meta_key = None,
+                }
+            }
+        }
+        ipv6_matches
+    }
+
+    fn allowed(address: &str) -> AllowedEndpoint {
+        AllowedEndpoint {
+            endpoint: Endpoint {
+                address: address.parse().unwrap(),
+                protocol: TransportProtocol::Udp,
+            },
+            clients: AllowedClients::Root,
+        }
+    }
+
+    /// Tunnel metadata on the loopback interface, which exists everywhere the tests run.
+    fn tunnel() -> TunnelMetadata {
+        TunnelMetadata {
+            interface: "lo".to_owned(),
+            dummy_dns: None,
+            ips: vec![
+                "10.64.0.2".parse().unwrap(),
+                "2001:db8:1::2".parse().unwrap(),
+            ],
+            ipv4_gateway: "10.64.0.1".parse().unwrap(),
+            ipv6_gateway: Some("2001:db8:1::1".parse().unwrap()),
+        }
+    }
+
+    /// Policies with both IPv4 and IPv6 addresses wherever a policy can carry them.
+    fn policies() -> Vec<FirewallPolicy> {
+        let peers = || vec![allowed("203.0.113.1:51820"), allowed("[2001:db8::1]:51820")];
+        vec![
+            FirewallPolicy::Connecting {
+                peer_endpoints: peers(),
+                tunnel: Some(tunnel()),
+                allow_lan: true,
+                allowed_endpoint: allowed("[2001:db8::2]:443"),
+                allowed_tunnel_traffic: AllowedTunnelTraffic::All,
+            },
+            FirewallPolicy::Connecting {
+                peer_endpoints: peers(),
+                tunnel: Some(tunnel()),
+                allow_lan: true,
+                allowed_endpoint: allowed("203.0.113.2:443"),
+                allowed_tunnel_traffic: AllowedTunnelTraffic::One(
+                    allowed("[2001:db8::3]:53").endpoint,
+                ),
+            },
+            FirewallPolicy::Connected {
+                peer_endpoints: peers(),
+                tunnel: tunnel(),
+                allow_lan: true,
+                dns_config: DnsConfig::from_addresses(
+                    &[
+                        "10.64.0.1".parse().unwrap(),
+                        "2001:db8:1::1".parse().unwrap(),
+                    ],
+                    &["192.168.1.1".parse().unwrap(), "fe80::1".parse().unwrap()],
+                )
+                .resolve(&[]),
+            },
+            FirewallPolicy::Blocked {
+                allow_lan: true,
+                allowed_endpoint: Some(allowed("[2001:db8::2]:443")),
+            },
+            FirewallPolicy::Disconnecting { allow_lan: true },
+        ]
+    }
+
+    /// Builds the rules for every policy in [`policies`] and returns how many IPv6-specific
+    /// matches there were.
+    fn ipv6_matches_in_policies(table_family: ProtoFamily) -> usize {
+        let table = Table::new(TABLE_NAME, table_family);
+        let firewall = Firewall {
+            fwmark: 0x6d6f6c65,
+            excluded_cgroup2: None,
+            net_cls: None,
+            table_family,
+        };
+        let mut ipv6_matches = 0;
+        for policy in policies() {
+            let batch = PolicyBatch::new(&table)
+                .finalize(&policy, &firewall)
+                .unwrap_or_else(|error| panic!("{policy}: {error}"));
+            let rules = rules(&batch);
+            assert!(!rules.is_empty(), "{policy}: no rules");
+            ipv6_matches += count_ipv6_matches(&rules);
+        }
+        ipv6_matches
+    }
+
+    /// Makes sure the policies exercise IPv6 at all, so that [`ip_table_has_no_ipv6_matches`]
+    /// means something.
+    #[test]
+    fn inet_table_has_ipv6_matches() {
+        assert!(ipv6_matches_in_policies(ProtoFamily::Inet) > 0);
+    }
+
+    /// The `ip` table, used when the kernel has no IPv6 support, must not contain IPv6 rules at
+    /// all: they could never match, and `nft` cannot display them.
+    #[test]
+    fn ip_table_has_no_ipv6_matches() {
+        assert_eq!(ipv6_matches_in_policies(ProtoFamily::Ipv4), 0);
+    }
+}
