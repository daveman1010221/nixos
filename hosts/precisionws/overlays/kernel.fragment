# precisionws's kernel: whitey's defconfig (hosts/whitey/overlays/defconfig) with these lines after it, then
# olddefconfig in the sandbox (flakes/kernel/sandbox). Regenerate .config and defconfig from them when whitey's changes.
# Why each group: hosts/precisionws/kernel-7.3-plan.md.
# Decided: no kCFI/FineIBT, no symbol trimming (the NVIDIA driver).
# CONFIG_CFI is not set
# CONFIG_TRIM_UNUSED_KSYMS is not set
# Intel, not AMD.
CONFIG_KVM_INTEL=m
# CONFIG_KVM_AMD is not set
CONFIG_PERF_EVENTS_INTEL_UNCORE=m
CONFIG_SENSORS_CORETEMP=m
CONFIG_EDAC_IE31200=m
# Graphics: the Xe iGPU drives the display; i915 is loaded and not bound (i915.force_probe=!a788).
CONFIG_DRM_XE=m
CONFIG_DRM_I915=m
CONFIG_NVIDIA_WMI_EC_BACKLIGHT=m
# Wi-Fi and Bluetooth: Intel AX211.
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_BT_INTEL_PCIE=m
# The ME, LPSS, pins, DMA.
CONFIG_INTEL_MEI=m
CONFIG_INTEL_MEI_ME=m
CONFIG_INTEL_MEI_HDCP=m
CONFIG_INTEL_MEI_PXP=m
CONFIG_INTEL_MEI_WDT=m
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_INTEL_IDMA64=m
CONFIG_PINCTRL_ALDERLAKE=m
# Input and sensors: the ISH, the I2C touchpad, the PS/2 keyboard.
CONFIG_INTEL_ISH_HID=m
CONFIG_HID_SENSOR_HUB=m
CONFIG_HID_SENSOR_CUSTOM_SENSOR=m
CONFIG_IIO=m
CONFIG_HID_SENSOR_IIO_COMMON=m
CONFIG_HID_SENSOR_ALS=m
CONFIG_HID_SENSOR_GYRO_3D=m
CONFIG_HID_SENSOR_CUSTOM_INTEL_HINGE=m
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=m
CONFIG_SERIO_RAW=m
CONFIG_INTEL_HID_EVENT=m
CONFIG_INTEL_VSEC=m
# Audio: SOF on the Alder/Raptor Lake PCH, SoundWire, the ALC269 codec, HDMI from the iGPU and the dGPU.
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_ALDERLAKE=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
CONFIG_SND_SOC_SOF_INTEL_SOUNDWIRE=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_INTEL=m
CONFIG_SND_HDA_CODEC_ALC269=m
CONFIG_SND_HDA_CODEC_HDMI_INTEL=m
CONFIG_SND_HDA_CODEC_HDMI_NVIDIA=m
# Dell.
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
CONFIG_DCDBAS=m
CONFIG_DELL_SMBIOS=m
CONFIG_DELL_WMI=m
CONFIG_DELL_WMI_DDV=m
CONFIG_DELL_WMI_SYSMAN=m
CONFIG_DELL_LAPTOP=m
CONFIG_DELL_PC=m
CONFIG_DELL_RBTN=m
CONFIG_SENSORS_DELL_SMM=m
# Intel power, thermal and telemetry.
CONFIG_INTEL_PMC_CORE=m
CONFIG_INTEL_PMT_TELEMETRY=m
CONFIG_INTEL_UNCORE_FREQ_CONTROL=m
CONFIG_INT340X_THERMAL=m
CONFIG_INTEL_POWERCLAMP=m
CONFIG_ACPI_TAD=m
# The rest of what this host loads.
CONFIG_SENSORS_SPD5118=m
CONFIG_ITCO_WDT=m
CONFIG_RAS_CEC=y
CONFIG_TYPEC_DP_ALTMODE=m
# Needed by RAS_CEC.
CONFIG_MEMORY_FAILURE=y
# CONFIG_SND_SOC_SOF_DEVELOPER_SUPPORT is not set
# Used by the iTCO watchdog and SMBus on this platform.
CONFIG_I2C_MUX=m
CONFIG_MFD_INTEL_PMC_BXT=m
# The nix-usernetes node's kubelet installs KUBE-FIREWALL through iptables-nft with -m comment.
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
# Not the firmware flash (intel-spi, spi-nor, MTD), though bound here: it is write access to the firmware, and this
# Dell updates its firmware by UEFI capsule, not through it; whitey builds no SPI either.
# Built into the stock kernel and in use here, which a check against lsmod cannot see (found from the drivers bound
# in /sys/bus/*/drivers, /sys/class/iommu and cpuidle, 2026-10-26):
# the IOMMU: dmar0 and dmar1 are active; intel_iommu=on, iommu.strict=1 and iommu=force ask for it, and Thunderbolt's
# DMA protection needs it.
CONFIG_INTEL_IOMMU=y
CONFIG_DMAR_TABLE=y
CONFIG_IRQ_REMAP=y
# idle states: the cpuidle driver is intel_idle (intel_idle.max_cstate=4).
CONFIG_INTEL_IDLE=y
# the touchpad's I2C bus: i2c_designware behind intel-lpss, where i2c_hid_acpi binds.
CONFIG_X86_INTEL_LPSS=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=m
# PCIe port services bound here: pciehp (Thunderbolt hotplug) and aer (bwctrl has no option in 7.3).
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_HOTPLUG_PCI_ACPI=y
CONFIG_PCIEAER=y
# Intel power and thermal, as the 6.19.8 config had them.
CONFIG_INTEL_HFI_THERMAL=y
CONFIG_INTEL_TURBO_MAX_3=y
CONFIG_ACPI_DPTF=y
# zswap compresses with zstd on this host (zswap.compressor=zstd).
CONFIG_CRYPTO_ZSTD=y
# What only whitey's AMD hardware uses.
# CONFIG_DRM_AMDGPU is not set
# CONFIG_SENSORS_K10TEMP is not set
# CONFIG_EDAC_AMD64 is not set
# CONFIG_SP5100_TCO is not set
# CONFIG_GPIO_AMDPT is not set
# CONFIG_GIGABYTE_WMI is not set
# CONFIG_R8169 is not set
# CONFIG_SND_HDA_CODEC_ALC882 is not set
# The node's iptables-nft rules use the comment match (xt_comment, loaded with the cluster up), which needs
# NETFILTER_ADVANCED; and with it on, options that default to on only without it are pinned to what they were.
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_NETFILTER_BPF_LINK=y
CONFIG_NETFILTER_EGRESS=y
CONFIG_NETFILTER_FAMILY_ARP=y
CONFIG_NETFILTER_INGRESS=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_SKIP_EGRESS=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_POLICY=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_TARGET_CONNSECMARK=y
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NETFILTER_XT_TARGET_SECMARK=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_IRC=y
CONFIG_NF_CONNTRACK_SECMARK=y
CONFIG_NF_CONNTRACK_SIP=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DUP_IPV4=m
CONFIG_NF_DUP_NETDEV=m
CONFIG_NF_FLOW_TABLE=m
CONFIG_NF_FLOW_TABLE_INET=m
CONFIG_NF_FLOW_TABLE_PROCFS=y
CONFIG_NF_LOG_ARP=m
CONFIG_NF_LOG_IPV4=m
CONFIG_NF_LOG_SYSLOG=m
CONFIG_NF_NAT=y
CONFIG_NF_NAT_FTP=y
CONFIG_NF_NAT_IRC=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NF_NAT_SIP=y
CONFIG_NF_REJECT_IPV4=m
CONFIG_NF_SOCKET_IPV4=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_ARP=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_COMPAT=m
CONFIG_NFT_COMPAT_ARP=m
CONFIG_NFT_CT=m
CONFIG_NFT_DUP_IPV4=m
CONFIG_NFT_DUP_NETDEV=m
CONFIG_NFT_EXTHDR_DCCP=y
CONFIG_NFT_FIB=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FWD_NETDEV=m
CONFIG_NFT_HASH=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_NAT=m
CONFIG_NFT_NUMGEN=m
CONFIG_NF_TPROXY_IPV4=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_IPV4=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_TPROXY=m
CONFIG_NFT_TUNNEL=m
CONFIG_NFT_XFRM=m
# From kernel-hardening-checker, appropriate here: TSX off (this CPU has it disabled already), and the IOMMU's
# shared virtual addressing (2026-10-26).
CONFIG_X86_INTEL_TSX_MODE_OFF=y
CONFIG_INTEL_IOMMU_SVM=y
