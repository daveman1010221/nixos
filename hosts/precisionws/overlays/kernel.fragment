# precisionws's kernel: whitey's defconfig (hosts/whitey/overlays/defconfig) with these lines after it, then
# olddefconfig in the sandbox (flakes/kernel/sandbox). Regenerate .config and defconfig from them when whitey's changes.
# Why each group: hosts/precisionws/kernel-7.3-plan.md.
# Decided: no kCFI/FineIBT, no symbol trimming (the NVIDIA driver).
# CONFIG_CFI is not set
# CONFIG_TRIM_UNUSED_KSYMS is not set
# Intel, not AMD.
CONFIG_KVM_INTEL=m
# CONFIG_KVM_AMD is not set
CONFIG_PERF_EVENTS_INTEL_UNCORE=m
CONFIG_SENSORS_CORETEMP=m
CONFIG_EDAC_IE31200=m
# Graphics: the Xe iGPU drives the display; i915 is loaded and not bound (i915.force_probe=!a788).
CONFIG_DRM_XE=m
CONFIG_DRM_I915=m
CONFIG_NVIDIA_WMI_EC_BACKLIGHT=m
# Wi-Fi and Bluetooth: Intel AX211.
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_BT_INTEL_PCIE=m
# The ME, LPSS, pins, DMA.
CONFIG_INTEL_MEI=m
CONFIG_INTEL_MEI_ME=m
CONFIG_INTEL_MEI_HDCP=m
CONFIG_INTEL_MEI_PXP=m
CONFIG_INTEL_MEI_WDT=m
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_INTEL_IDMA64=m
CONFIG_PINCTRL_ALDERLAKE=m
# Input and sensors: the ISH, the I2C touchpad, the PS/2 keyboard.
CONFIG_INTEL_ISH_HID=m
CONFIG_HID_SENSOR_HUB=m
CONFIG_HID_SENSOR_CUSTOM_SENSOR=m
CONFIG_IIO=m
CONFIG_HID_SENSOR_IIO_COMMON=m
CONFIG_HID_SENSOR_ALS=m
CONFIG_HID_SENSOR_GYRO_3D=m
CONFIG_HID_SENSOR_CUSTOM_INTEL_HINGE=m
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
CONFIG_SERIO_I8042=m
CONFIG_KEYBOARD_ATKBD=m
CONFIG_SERIO_RAW=m
CONFIG_INTEL_HID_EVENT=m
CONFIG_INTEL_VSEC=m
# Audio: SOF on the Alder/Raptor Lake PCH, SoundWire, the ALC269 codec, HDMI from the iGPU and the dGPU.
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_ALDERLAKE=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
CONFIG_SND_SOC_SOF_INTEL_SOUNDWIRE=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_INTEL=m
CONFIG_SND_HDA_CODEC_ALC269=m
CONFIG_SND_HDA_CODEC_HDMI_INTEL=m
CONFIG_SND_HDA_CODEC_HDMI_NVIDIA=m
# Dell.
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
CONFIG_DCDBAS=m
CONFIG_DELL_SMBIOS=m
CONFIG_DELL_WMI=m
CONFIG_DELL_WMI_DDV=m
CONFIG_DELL_WMI_SYSMAN=m
CONFIG_DELL_LAPTOP=m
CONFIG_DELL_PC=m
CONFIG_DELL_RBTN=m
CONFIG_SENSORS_DELL_SMM=m
# Intel power, thermal and telemetry.
CONFIG_INTEL_PMC_CORE=m
CONFIG_INTEL_PMT_TELEMETRY=m
CONFIG_INTEL_UNCORE_FREQ_CONTROL=m
CONFIG_INT340X_THERMAL=m
CONFIG_INTEL_POWERCLAMP=m
CONFIG_ACPI_TAD=m
# The rest of what this host loads.
CONFIG_SENSORS_SPD5118=m
CONFIG_ITCO_WDT=m
CONFIG_RAS_CEC=y
CONFIG_TYPEC_DP_ALTMODE=m
# Needed by RAS_CEC.
CONFIG_MEMORY_FAILURE=y
# CONFIG_SND_SOC_SOF_DEVELOPER_SUPPORT is not set
# Used by the iTCO watchdog and SMBus on this platform.
CONFIG_I2C_MUX=m
CONFIG_MFD_INTEL_PMC_BXT=m
# The nix-usernetes node's kubelet installs KUBE-FIREWALL through iptables-nft with -m comment.
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
